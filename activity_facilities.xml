<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F4F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="← Home" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Nearby Facilities" android:textColor="#123B66"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Choose a destination inside the mall." android:textColor="#526579"
            android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:padding="14dp" android:background="#FFFFFF"
            android:text="Restroom\nPrayer Room / Qibla\nEmergency Exit\nHelp Desk / Lost & Found"
            android:textColor="#26384A" android:textSize="18sp" />
        
        <Button
            android:id="@+id/btnFacilityRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:text="Get Route (Demo)" />
    </LinearLayout>
</ScrollView>
